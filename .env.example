# RapidAPI — Boxing Data API (https://rapidapi.com/bengroves1993/api/boxing-data-api)
# On Vercel: add to Project → Settings → Environment Variables (Production) and redeploy.
RAPIDAPI_KEY=

# Currents API — Authorization header value (see https://currentsapi.services/)
CURRENTS_API_KEY=

# Optional: bearer | raw (default: send key as-is unless it already starts with Bearer)
# CURRENTS_AUTH_MODE=bearer

# Optional overrides — Boxing Data API
# BOXING_DATA_API_BASE_URL=https://boxing-data-api.p.rapidapi.com
# BOXING_DATA_REVALIDATE_SECONDS=1800
# BOXING_UPCOMING_DAYS=14
# BOXING_FIGHTS_PAGE_SIZE=6
# BOXING_EVENTS_PAGE_SIZE=6

# YouTube Data API v3 — auto-fetch tutorial duration in Sanity Studio (/admin)
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=

# Optional overrides — Currents (sports headlines on home marquee)
# CURRENTS_API_REVALIDATE_SECONDS=3600
# CURRENTS_NEWS_LANGUAGE=en
# CURRENTS_NEWS_CATEGORY=sports
# CURRENTS_NEWS_KEYWORDS=sports
